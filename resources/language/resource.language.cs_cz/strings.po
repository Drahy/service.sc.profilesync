msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgctxt "#30000"
msgid "Private profile synchronization"
msgstr "Soukromá synchronizace profilu"

msgctxt "#30001"
msgid "Synchronize preferences and viewing history"
msgstr "Synchronizovat nastavení a historii sledování"

msgctxt "#30002"
msgid "Local change check (seconds)"
msgstr "Kontrola místních změn (sekundy)"

msgctxt "#30003"
msgid "Cloud synchronization (seconds)"
msgstr "Synchronizace přes cloud (sekundy)"

msgctxt "#30004"
msgid "Hide subtitles with Czech audio; otherwise prefer Czech, then English"
msgstr ""
"S českým zvukem skrýt titulky; jinak upřednostnit češtinu a poté angličtinu"

msgctxt "#30005"
msgid "Synchronize now"
msgstr "Synchronizovat nyní"

msgctxt "#30006"
msgid ""
"Uses the existing Stream Cinema Kra account. Hardware and account settings "
"stay local."
msgstr ""
"Používá stávající účet Stream Cinema na Kra. Nastavení zařízení a účtů "
"zůstává místní."

msgctxt "#30007"
msgid "Up Next settings"
msgstr "Nastavení Up Next"

msgctxt "#30008"
msgid "Catalogue unavailable; Webshare remains available"
msgstr "Katalog není dostupný; Webshare lze stále používat"

msgctxt "#30009"
msgid "Connection is still unavailable. Please try again later."
msgstr "Připojení stále není dostupné. Zkuste to znovu později."

msgctxt "#30010"
msgid "Connection unavailable. Retrying the last episode list."
msgstr "Připojení není dostupné. Zkouším znovu načíst seznam epizod."

msgctxt "#30011"
msgid "Last Seen"
msgstr "Naposledy sledované"

msgctxt "#30012"
msgid "Start over from this season"
msgstr "Začít znovu od této řady"

msgctxt "#30013"
msgid "Clear watched marks and resume positions for this show from Season {} onwards on your synchronized devices? Earlier seasons will be kept."
msgstr "Vymazat označení zhlédnutých dílů a rozkoukané pozice u tohoto seriálu od {}. řady dál na synchronizovaných zařízeních? Historie předchozích řad zůstane zachována."

msgctxt "#30014"
msgid "Stop playback before resetting viewing history."
msgstr "Před vymazáním historie sledování zastav přehrávání."

msgctxt "#30015"
msgid "Reset history"
msgstr "Vymazat historii"

msgctxt "#30016"
msgid "Viewing history was not changed. Please try again."
msgstr "Historie sledování se nezměnila. Zkus to znovu."
