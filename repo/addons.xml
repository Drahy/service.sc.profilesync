<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="service.sc.profilesync" name="SC Profile Sync" version="0.1.5" provider-name="Drahy">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="script.module.requests" version="2.25.1" />
      <import addon="plugin.video.stream-cinema" version="2.6.7.1" />
      <import addon="service.upnext" version="1.2.1" />
    </requires>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.python.script" library="sync_now.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Share Stream Cinema preferences and viewing history through private Kra storage.</summary>
      <description lang="en_GB">Synchronize viewing history, language, subtitle appearance, interface sounds, common addon preferences and portable Amber appearance. Save captured core preferences before acknowledging them. Hide subtitles with Czech audio, otherwise prefer Czech then English. Keep credentials, hardware and paths local.</description>
      <platform>all</platform>
      <license>GPL-3.0-only</license>
      <source>https://github.com/Drahy/service.sc.profilesync</source>
      <website>https://github.com/Drahy/service.sc.profilesync</website>
      <news>0.1.5: Reopen the last episode after Exit and reduce repeated profile-copy and GUI work in the matching Stream Cinema integration.</news>
    </extension>
  </addon>
  <addon id="repository.drahy.scprofilesync" name="Drahy's SC Profile Sync Repository" version="1.0.0" provider-name="Drahy">
    <requires>
      <import addon="xbmc.addon" version="12.0.0" />
    </requires>
    <extension point="xbmc.addon.repository">
      <dir>
        <info>https://raw.githubusercontent.com/Drahy/service.sc.profilesync/main/repo/addons.xml</info>
        <checksum verify="sha256">https://raw.githubusercontent.com/Drahy/service.sc.profilesync/main/repo/addons.xml.sha256</checksum>
        <datadir>https://raw.githubusercontent.com/Drahy/service.sc.profilesync/main/repo/</datadir>
        <hashes>sha256</hashes>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Install and update SC Profile Sync.</summary>
      <description lang="en_GB">The Kodi repository for SC Profile Sync. Stream Cinema and other dependencies come from their existing repositories.</description>
      <platform>all</platform>
      <license>GPL-3.0-only</license>
      <source>https://github.com/Drahy/service.sc.profilesync</source>
    </extension>
  </addon>
</addons>
