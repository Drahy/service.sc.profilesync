+++ b/resources/lib/popup_recovery.py
@@ -0,0 +1,107 @@
+"""Keep an active add-on popup in Kodi's in-memory window across service restarts."""
+import hashlib
+import json
+import threading
+from datetime import date
+from utils import clear_property, get_property, set_property
+
+KEY = 'service.upnext.recovery.v1'
+WAKE_KEY = 'service.upnext.recovery.wake'
+_lock = threading.RLock()
+
+
+def file_key(filename):
+    return hashlib.sha256(filename.encode('utf-8')).hexdigest()
+
+
+def clear():
+    with _lock:
+        try:
+            clear_property(KEY)
+            clear_property(WAKE_KEY)
+        except RuntimeError:
+            pass
+
+
+def request_wake():
+    with _lock:
+        try:
+            if get_property(KEY):
+                set_property(WAKE_KEY, 'true')
+        except RuntimeError:
+            pass
+
+
+def wake_requested():
+    try:
+        return get_property(WAKE_KEY) == 'true' and bool(get_property(KEY))
+    except RuntimeError:
+        return False
+
+
+def wake_handled():
+    try:
+        clear_property(WAKE_KEY)
+    except RuntimeError:
+        pass
+
+
+def remember(filename, api, state, *, refresh=False):
+    """Only recover add-on data without a queued playlist item."""
+    with _lock:
+        if refresh:
+            try:
+                if not get_property(KEY):
+                    return
+            except RuntimeError:
+                return
+        if not filename or not isinstance(api.data, dict) or not api.data.get('next_episode') or state.queued:
+            clear()
+            return
+        timer = state.watch_timer
+        snapshot = {
+            'v': 1, 'file': file_key(filename), 'data': api.data, 'encoding': api.encoding,
+            'count': state.played_in_a_row, 'show': state.current_tv_show_id,
+            'elapsed': timer.elapsed,
+            'pending': timer.bedtime_pending.isoformat() if timer.bedtime_pending else None,
+            'ack': timer.bedtime_acknowledged.isoformat() if timer.bedtime_acknowledged else None,
+        }
+        try:
+            set_property(KEY, json.dumps(snapshot, separators=(',', ':')))
+        except (TypeError, ValueError, RuntimeError):
+            clear()
+
+
+def read():
+    try:
+        value = json.loads(get_property(KEY))
+        if (not isinstance(value, dict) or value.get('v') != 1 or not isinstance(value.get('file'), str)
+                or not isinstance(value.get('data'), dict) or not value['data'].get('next_episode')):
+            return None
+        return value
+    except (TypeError, ValueError, RuntimeError):
+        return None
+
+
+def restore(snapshot, filename, api, player, paused):
+    if not filename or file_key(filename) != snapshot['file']:
+        return False
+    try:
+        elapsed = max(0, float(snapshot.get('elapsed', 0)))
+        pending = date.fromisoformat(snapshot['pending']) if snapshot.get('pending') else None
+        acknowledged = date.fromisoformat(snapshot['ack']) if snapshot.get('ack') else None
+        count = max(1, int(snapshot.get('count', 1)))
+    except (ValueError, TypeError, OverflowError):
+        return False
+    state = player.state
+    api.addon_data_received(snapshot['data'], encoding=snapshot.get('encoding') or 'base64')
+    state.played_in_a_row = count
+    state.current_tv_show_id = snapshot.get('show')
+    state.watch_timer.elapsed = elapsed
+    state.watch_timer.bedtime_pending = pending
+    state.watch_timer.bedtime_acknowledged = acknowledged
+    state.watch_timer.suspend()
+    state.pause = bool(paused)
+    player.set_last_file(None)
+    player.enable_tracking()
+    return True
